@@ -0,0 +1,335 @@
+import { describe, expect, it } from "vitest";
+import { preCompactionPrune } from "./pre-compaction-pruning.js";
+import type { AgentMessage } from "../runtime/index.js";
+
+// ── Suite B: Pre-Compaction Pruning ──
+
+function makeToolResult(overrides: Partial<{
+  toolCallId: string;
+  toolName: string;
+  content: string;
+  isError: boolean;
+  timestamp: number;
+}> = {}): AgentMessage {
+  return {
+    role: "toolResult",
+    toolCallId: overrides.toolCallId ?? "tc-1",
+    toolName: overrides.toolName ?? "Read",
+    content: [{ type: "text", text: overrides.content ?? "file content" }],
+    isError: overrides.isError ?? false,
+    timestamp: overrides.timestamp ?? Date.now(),
+  } as unknown as AgentMessage;
+}
+
+function makeAssistantWithToolCalls(
+  toolCalls: Array<{
+    id: string;
+    name: string;
+    arguments: Record<string, unknown>;
+  }>,
+): AgentMessage {
+  return {
+    role: "assistant",
+    model: "test-model",
+    provider: "test",
+    content: toolCalls.map((tc) => ({
+      type: "toolCall" as const,
+      id: tc.id,
+      name: tc.name,
+      arguments: tc.arguments,
+    })),
+    stopReason: "toolCall",
+    usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0 },
+    timestamp: Date.now(),
+  } as unknown as AgentMessage;
+}
+
+function makeUserMessage(text: string): AgentMessage {
+  return {
+    role: "user",
+    content: [{ type: "text", text }],
+    timestamp: Date.now(),
+  } as unknown as AgentMessage;
+}
+
+const longContent = "x".repeat(500);
+const shortContent = "short";
+
+describe("preCompactionPrune — sub-pass 1: deduplication", () => {
+  it("replaces duplicate tool results with dedup placeholder", () => {
+    const messages = [
+      makeUserMessage("hello"),
+      makeToolResult({ content: longContent, toolCallId: "tc-1" }),
+      makeUserMessage("another"),
+      makeToolResult({ content: longContent, toolCallId: "tc-2" }),
+      makeUserMessage("more"),
+      makeToolResult({ content: longContent, toolCallId: "tc-3" }),
+    ];
+    // Boundary at 4 → indices 0-3 are "old", 4-5 are protected
+    const { pruned, prunedCount } = preCompactionPrune(messages, 2);
+    // The oldest duplicates before boundary should be replaced
+    const text1 = (pruned[1] as any).content[0].text;
+    expect(text1).toContain("Duplicate");
+    expect(prunedCount).toBeGreaterThan(0);
+  });
+
+  it("does not deduplicate content shorter than 200 chars", () => {
