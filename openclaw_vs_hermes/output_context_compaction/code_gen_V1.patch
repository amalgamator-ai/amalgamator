index 0000000000..96bb1bcb25
--- /dev/null
+++ b/src/agents/agent-hooks/pre-compaction-pruning.ts
@@ -0,0 +1,186 @@
+// Pre-compaction pruning: replace old tool result contents with informative
+// 1-line summaries before LLM summarization.
+import { createHash } from "node:crypto";
+import type { AgentMessage } from "../runtime/index.js";
+
+/**
+ * Pre-compaction pruning: replaces old tool result contents with
+ * informative 1-line summaries before LLM summarization.
+ *
+ * Three sub-passes:
+ *   1. Deduplicate identical tool results (hash-based)
+ *   2. Replace old tool results with 1-line summaries
+ *   3. Truncate large tool call arguments
+ *
+ * @param messages - Messages to prune (will NOT be mutated).
+ * @param protectTailCount - Number of recent messages to protect.
+ * @returns A new message array with pruned content.
+ */
+export function preCompactionPrune(
+  messages: readonly AgentMessage[],
+  protectTailCount: number,
+): { pruned: AgentMessage[]; prunedCount: number } {
+  if (messages.length === 0) {
+    return { pruned: [], prunedCount: 0 };
+  }
+
+  const pruneBoundary = Math.max(0, messages.length - protectTailCount);
+  let result = [...messages] as AgentMessage[];
+  let prunedCount = 0;
+
+  // ── Sub-pass 1: Deduplicate identical tool results ──
+  const contentHashes = new Map<string, number>(); // hash → newest index
+
+  // Walk forward to find newest index for each content hash
+  for (let i = 0; i < result.length; i++) {
+    const msg = result[i] as any;
+    if (msg.role !== "toolResult") continue;
+    const text = extractToolResultText(msg);
+    if (text.length <= 200) continue;
+    const hash = hashContent(text);
+    contentHashes.set(hash, i);
+  }
+
+  // Walk through old messages and deduplicate
+  for (let i = 0; i < pruneBoundary; i++) {
+    const msg = result[i] as any;
+    if (msg.role !== "toolResult") continue;
+    const text = extractToolResultText(msg);
+    if (text.length <= 200) continue;
+    const hash = hashContent(text);
+    const newestIdx = contentHashes.get(hash);
+    if (newestIdx !== undefined && newestIdx !== i) {
+      result[i] = cloneToolResultWithText(
+        msg,
+        "[Duplicate tool output — same content as a more recent call]",
+      );
+      prunedCount++;
+    }
+  }
+
+  // ── Sub-pass 2: Replace old tool results with 1-line summaries ──
+  for (let i = 0; i < pruneBoundary; i++) {
+    const msg = result[i] as any;
+    if (msg.role !== "toolResult") continue;
+    const text = extractToolResultText(msg);
+    // Skip already-deduplicated or short content
+    if (text.length <= 200 || text.startsWith("[Duplicate tool output")) continue;
+    const summary = buildToolSummary(msg.toolName, text);
+    result[i] = cloneToolResultWithText(msg, summary);
+    prunedCount++;
+  }
+
+  // ── Sub-pass 3: Truncate large tool call arguments ──
+  for (let i = 0; i < pruneBoundary; i++) {
+    const msg = result[i] as any;
+    if (msg.role !== "assistant" || !Array.isArray(msg.content)) continue;
+
+    let modified = false;
+    const newContent = msg.content.map((block: any) => {
+      if (block.type !== "toolCall") return block;
+      const args = block.arguments;
+      if (!args || typeof args !== "object") return block;
+
+      const serialized = JSON.stringify(args);
+      if (serialized.length <= 500) return block;
+
+      const truncatedArgs = truncateObjectStringValues(args);
+      modified = true;
+      return { ...block, arguments: truncatedArgs };
+    });
+
+    if (modified) {
+      result[i] = { ...msg, content: newContent } as AgentMessage;
+      prunedCount++;
+    }
+  }
+
+  return { pruned: result, prunedCount };
+}
+
+// ---------------------------------------------------------------------------
+// Internal helpers
+// ---------------------------------------------------------------------------
+
+function extractToolResultText(msg: any): string {
+  if (typeof msg.content === "string") return msg.content;
+  if (!Array.isArray(msg.content)) return "";
+  return msg.content
+    .filter((c: any) => c.type === "text" && typeof c.text === "string")
+    .map((c: any) => c.text)
+    .join("\n");
+}
+
+function hashContent(text: string): string {
+  return createHash("sha256").update(text).digest("hex").slice(0, 12);
+}
+
+function cloneToolResultWithText(msg: any, text: string): AgentMessage {
+  return {
+    ...msg,
+    content: [{ type: "text" as const, text }],
+  } as AgentMessage;
+}
+
+function buildToolSummary(toolName: string, text: string): string {
+  const charCount = text.length;
+  const lineCount = text.split("\n").length;
+
+  switch (toolName) {
+    case "Bash": {
+      const cmdMatch = text.match(/^(?:Ran `([^`]+)`|> (.+))/m);
+      const cmd = cmdMatch?.[1] ?? cmdMatch?.[2] ?? "command";
+      const exitMatch = text.match(/exit(?:ed with)?\s*(?:code\s*)?(\d+)/i);
+      const exitCode = exitMatch?.[1] ?? "0";
+      return `[Bash] ran \`${cmd.slice(0, 80)}\` → exit ${exitCode}, ${lineCount} lines`;
+    }
+    case "Read": {
+      const pathMatch = text.match(/(?:read|file)\s+(.+?)(?:\s|$)/i) ?? text.match(/^(.+?)$/m);
+      const path = pathMatch?.[1]?.trim().slice(0, 100) ?? "file";
+      return `[Read] read ${path} (${charCount} chars)`;
+    }
+    case "Write": {
+      const pathMatch = text.match(/(?:wrote|write|file)\s+(.+?)(?:\s|$)/i) ?? text.match(/^(.+?)$/m);
+      const path = pathMatch?.[1]?.trim().slice(0, 100) ?? "file";
+      return `[Write] wrote ${path}`;
+    }
+    case "Grep": {
+      const patternMatch = text.match(/(?:search|grep|pattern)\s+['"]?(.+?)['"]?\s/i);
+      const pattern = patternMatch?.[1]?.slice(0, 50) ?? "pattern";
+      const matchCount = (text.match(/\n/g) ?? []).length;
+      return `[Grep] searched for '${pattern}' → ${matchCount} matches`;
+    }
+    case "Glob": {
+      const patternMatch = text.match(/(?:glob|pattern)\s+['"]?(.+?)['"]?\s/i);
+      const pattern = patternMatch?.[1]?.slice(0, 50) ?? "pattern";
+      const resultCount = (text.match(/\n/g) ?? []).length;
+      return `[Glob] searched for '${pattern}' → ${resultCount} results`;
+    }
+    case "Edit": {
+      const pathMatch = text.match(/(?:edit|file)\s+(.+?)(?:\s|$)/i) ?? text.match(/^(.+?)$/m);
+      const path = pathMatch?.[1]?.trim().slice(0, 100) ?? "file";
+      return `[Edit] edited ${path}`;
+    }
+    case "WebFetch": {
+      const urlMatch = text.match(/(?:url|fetch)\s+(https?:\/\/[^\s]+)/i);
+      const url = urlMatch?.[1]?.slice(0, 80) ?? "url";
+      return `[WebFetch] fetched ${url} (${charCount} chars)`;
+    }
+    default:
+      return `[${toolName}] (${charCount} chars result)`;
+  }
+}
+
+function truncateObjectStringValues(obj: Record<string, unknown>): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  for (const [key, value] of Object.entries(obj)) {
+    if (typeof value === "string" && value.length > 200) {
+      result[key] = value.slice(0, 150) + "...[truncated]";
+    } else if (value !== null && typeof value === "object" && !Array.isArray(value)) {
+      result[key] = truncateObjectStringValues(value as Record<string, unknown>);
+    } else {
+      result[key] = value;
+    }
+  }
+  return result;
+}
