+import { describe, expect, it } from "vitest";
+import {
+  COMPACTION_SUMMARY_PREFIX,
+  COMPACTION_SUMMARY_SUFFIX,
+  COMPACTION_SUMMARY_END_MARKER,
+} from "../messages.js";
+
+// ── Suite D: Summary Prefix Disambiguation ──
+
+describe("enhanced compaction summary prefix", () => {
+  it("contains 'REFERENCE ONLY' disambiguation directive", () => {
+    expect(COMPACTION_SUMMARY_PREFIX.toUpperCase()).toContain("REFERENCE ONLY");
+  });
+
+  it("contains directive to respond to latest user message", () => {
+    expect(COMPACTION_SUMMARY_PREFIX).toMatch(
+      /respond.*(?:only|latest|after|below)/i,
+    );
+  });
+
+  it("contains directive about not fulfilling summary requests", () => {
+    expect(COMPACTION_SUMMARY_PREFIX).toMatch(
+      /(?:not|don't|do not).*(?:answer|fulfill|respond)/i,
+    );
+  });
+
+  it("is backward-compatible with existing prefix concept", () => {
+    // Must still reference compaction/summary
+    expect(COMPACTION_SUMMARY_PREFIX).toMatch(/compact|summary/i);
+  });
+});
+
+describe("compaction summary end marker", () => {
+  it("end marker contains boundary directive", () => {
+    expect(COMPACTION_SUMMARY_END_MARKER).toMatch(/end|---/i);
+  });
+
+  it("end marker directs attention to messages below", () => {
+    expect(COMPACTION_SUMMARY_END_MARKER).toMatch(/below|after|following/i);
+  });
+});
+
+describe("summary wrapping", () => {
+  it("convertToLlm output includes end marker after summary", () => {
+    // The end marker is appended in convertToLlm's compactionSummary case.
+    // We verify the marker constant is properly defined for that purpose.
+    const combined =
+      COMPACTION_SUMMARY_PREFIX +
+      "## Goal\nBuild feature X" +
+      COMPACTION_SUMMARY_SUFFIX +
+      "\n\n" +
+      COMPACTION_SUMMARY_END_MARKER;
+
+    expect(combined).toContain("REFERENCE ONLY");
+    expect(combined).toContain("## Goal\nBuild feature X");
+    expect(combined).toContain(COMPACTION_SUMMARY_END_MARKER);
+  });
+
+  it("handles empty summary string in assembled form", () => {
+    const combined =
+      COMPACTION_SUMMARY_PREFIX +
+      "" +
+      COMPACTION_SUMMARY_SUFFIX +
+      "\n\n" +
+      COMPACTION_SUMMARY_END_MARKER;
+
+    expect(combined.length).toBeGreaterThan(0);
+    expect(combined).toContain(COMPACTION_SUMMARY_END_MARKER);
+  });
+});
