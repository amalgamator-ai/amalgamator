{
    "profiles": [
        {
            "model": "nvidia/DeepSeek-R1-NVFP4",
            "num_gpus": 4,
            "exec_mode": "pure_decode",
            "frameworks": [
                {
                    "name": "vllm",
                    "enable_trace": true,
                    "server_args": {
                        "extra_flags": "--kv-cache-dtype fp8 --block-size 256",
                        "extra_env": {}
                    },
                    "client_args": {
                        "extra_flags": ""
                    }
                },
                {
                    "name": "sgl",
                    "enable_trace": true,
                    "server_args": {
                        "extra_flags": "--moe-runner-backend marlin",
                        "extra_env": {},
                        "prepare_cmds": ["pip install distro"]
                    },
                    "client_args": {
                        "extra_flags": ""
                    }
                }
            ]
        }
    ],
    "concurrencies": [1, 16, 64],
    "stability_threshold_pct": 5.0,
    "max_stability_retries": 3,
    "metrics_poll_interval_sec": 1.0,
    "docker_images": {
        "vllm": "vllm/vllm-openai:latest",
        "sgl": "lmsysorg/sglang:dev-cu13",
        "trt": "nvcr.io/nvidia/tensorrt-llm/release:1.3.0rc11"
    },
    "exec_modes": {
        "pure_decode": {
            "input_len": 4,
            "output_len": 1024
        },
        "pure_prefill": {
            "input_len": 1024,
            "output_len": 1
        },
        "prefill_1500_decode_500": {
            "input_len": 1500,
            "output_len": 500
        }
    }
}
