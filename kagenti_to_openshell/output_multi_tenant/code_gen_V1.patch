+        let admin = make_admin("admin-1");
+        let result = stamp_owner_labels(&admin, &config, HashMap::new());
+        assert_eq!(result.get(LABEL_OWNER), Some(&"admin-1".to_string()));
+    }
+
+    #[test]
+    fn stamp_preserves_user_labels() {
+        let config = test_ownership_config(true);
+        let user = make_user("user-1", "openshell-user");
+        let mut labels = HashMap::new();
+        labels.insert("env".to_string(), "dev".to_string());
+        let result = stamp_owner_labels(&user, &config, labels);
+        assert_eq!(result.get("env"), Some(&"dev".to_string()));
