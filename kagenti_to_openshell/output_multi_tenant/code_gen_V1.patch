+    fn selector_admin_returns_none() {
+        let config = test_ownership_config(true);
+        let admin = make_admin("admin-1");
+        assert!(owner_label_selector(&admin, &config).is_none());
+    }
+
+    #[test]
+    fn selector_anonymous_returns_none() {
+        let config = test_ownership_config(true);
+        assert!(owner_label_selector(&Principal::Anonymous, &config).is_none());
+    }
+
+    #[test]
+    fn selector_sanitizes_subject() {
+        let config = test_ownership_config(true);
