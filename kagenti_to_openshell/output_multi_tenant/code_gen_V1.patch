+// SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Per-user ownership enforcement for multi-tenant deployments.
+//!
+//! Stamps `openshell.ai/owner` labels on sandbox and provider objects at
+//! creation time, and enforces ownership checks on get/delete/update
+//! operations. Admin principals bypass ownership checks.
+//!
+//! Ported from Kagenti's gateway-per-tenant ownership model.
+
+use crate::auth::principal::Principal;
+use openshell_core::driver_utils::{LABEL_OWNER, LABEL_TENANT};
+use std::collections::HashMap;
+use tonic::Status;
+
+/// Configuration for per-user ownership enforcement.
+#[derive(Debug, Clone)]
+pub struct OwnershipConfig {
+    /// When true, ownership labels are stamped and enforced.
+    pub enabled: bool,
+    /// Role name that grants admin access (bypasses ownership checks).
+    pub admin_role: String,
+    /// Optional tenant identifier stamped on all objects created by this gateway.
+    pub tenant_id: Option<String>,
+}
+
+impl Default for OwnershipConfig {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            admin_role: "openshell-admin".to_string(),
+            tenant_id: None,
+        }
+    }
+}
+
+/// Sanitize a string for use as a Kubernetes label value.
+///
+/// K8s label values must be at most 63 characters and contain only
+/// alphanumeric characters, dashes, underscores, and dots. Must start
+/// and end with an alphanumeric character.
+pub(crate) fn sanitize_label_value(raw: &str) -> String {
+    let sanitized: String = raw
+        .chars()
+        .map(|c| {
+            if c.is_ascii_alphanumeric() || c == '-' || c == '_' || c == '.' {
+                c
+            } else {
+                '_'
+            }
+        })
+        .take(63)
+        .collect();
+
+    // Trim leading/trailing non-alphanumeric characters.
+    let sanitized = sanitized.trim_start_matches(|c: char| !c.is_ascii_alphanumeric());
+    let sanitized = sanitized.trim_end_matches(|c: char| !c.is_ascii_alphanumeric());
+
+    sanitized.to_string()
+}
+
+/// Stamp owner and tenant labels onto an object's label map.
+///
+/// - Strips any client-supplied `openshell.ai/*` labels (anti-spoofing).
+/// - Adds `openshell.ai/owner` from the principal's subject.
+/// - Adds `openshell.ai/tenant` if a tenant_id is configured.
+/// - Returns labels unchanged when ownership is disabled or the principal
+///   is anonymous.
+pub(crate) fn stamp_owner_labels(
+    principal: &Principal,
+    config: &OwnershipConfig,
+    mut labels: HashMap<String, String>,
+) -> HashMap<String, String> {
+    if !config.enabled {
+        return labels;
+    }
+
+    let identity = match principal {
+        Principal::User(u) => &u.identity,
+        // Sandbox principals and anonymous callers don't get owner labels.
+        _ => return labels,
+    };
+
+    // Strip any client-supplied openshell.ai/* labels (anti-spoofing).
+    labels.retain(|key, _| !key.starts_with("openshell.ai/"));
+
+    // Stamp owner from identity subject.
+    let owner = sanitize_label_value(&identity.subject);
+    if !owner.is_empty() {
+        labels.insert(LABEL_OWNER.to_string(), owner);
+    }
+
+    // Stamp tenant if configured.
+    if let Some(ref tenant_id) = config.tenant_id {
+        let tenant = sanitize_label_value(tenant_id);
+        if !tenant.is_empty() {
+            labels.insert(LABEL_TENANT.to_string(), tenant);
+        }
+    }
+
+    labels
+}
+
+/// Check whether a principal owns an object identified by its labels.
+///
+/// - Returns `Ok(())` when ownership is disabled.
+/// - Returns `Ok(())` for admin principals (they bypass ownership).
+/// - Returns `Ok(())` for anonymous principals (backward compatibility).
+/// - Returns `Err(PermissionDenied)` when the owner label doesn't match.
+/// - Returns `Ok(())` when the object has no owner label (shared/legacy).
+pub(crate) fn check_ownership(
+    principal: &Principal,
+    config: &OwnershipConfig,
+    labels: &HashMap<String, String>,
+) -> Result<(), Status> {
+    if !config.enabled {
+        return Ok(());
+    }
+
+    let identity = match principal {
+        Principal::User(u) => &u.identity,
+        // Sandbox principals are scoped by sandbox_id, not ownership.
+        Principal::Sandbox(_) => return Ok(()),
+        // Anonymous principals bypass ownership (backward compatibility).
+        Principal::Anonymous => return Ok(()),
+    };
+
+    // Admin bypass.
+    if identity.roles.iter().any(|r| r == &config.admin_role) {
+        return Ok(());
+    }
+
+    // If the object has no owner label, it's a shared/legacy object — allow.
+    let Some(owner) = labels.get(LABEL_OWNER) else {
+        return Ok(());
+    };
+
+    let caller_owner = sanitize_label_value(&identity.subject);
+    if *owner == caller_owner {
+        Ok(())
+    } else {
+        Err(Status::permission_denied(
+            "access denied: you do not own this resource",
+        ))
+    }
+}
+
+/// Build a label selector string for filtering objects by owner.
+///
+/// Returns `None` when ownership is disabled, the principal is anonymous,
+/// or the principal is an admin (admins see all objects).
+///
+/// Returns `Some("openshell.ai/owner=<sanitized-subject>")` for regular users.
+pub(crate) fn owner_label_selector(
+    principal: &Principal,
+    config: &OwnershipConfig,
+) -> Option<String> {
+    if !config.enabled {
+        return None;
+    }
+
+    let identity = match principal {
+        Principal::User(u) => &u.identity,
+        // Sandbox principals don't list objects.
+        Principal::Sandbox(_) => return None,
+        // Anonymous principals see everything (backward compatibility).
+        Principal::Anonymous => return None,
+    };
+
+    // Admin bypass — admins see all objects.
+    if identity.roles.iter().any(|r| r == &config.admin_role) {
+        return None;
+    }
+
+    let owner = sanitize_label_value(&identity.subject);
+    if owner.is_empty() {
+        return None;
+    }
+
+    Some(format!("{LABEL_OWNER}={owner}"))
+}
