+    /// Build an [`OwnershipConfig`] from the gateway configuration.
+    pub(crate) fn ownership_config(&self) -> crate::auth::ownership::OwnershipConfig {
+        let admin_role = self
+            .config
+            .oidc
+            .as_ref()
+            .map(|oidc| oidc.admin_role.clone())
+            .unwrap_or_else(|| "openshell-admin".to_string());
+
+        crate::auth::ownership::OwnershipConfig {
+            enabled: self.config.ownership.enabled,
+            admin_role,
+            tenant_id: self.config.ownership.tenant_id.clone(),
+        }
+    }
 }
 
