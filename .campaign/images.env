# Pinned campaign images. Every docker invocation in this campaign sources this
# file, so no run depends on whatever a floating tag happens to resolve to.
#
# Both are ROCm 10:
#   vllm    torch 2.13.0+rocm10.0.0  (ROCm 10.0 via the ROCm SDK wheels; the
#           image has no /opt/rocm, hipconfig from the bundled SDK reports
#           7.15.26333, which is TheRock's internal numbering, not ROCm 6/7)
#   sglang  ROCm 10.0 (/opt/rocm/.info/version = 10.0.0), torch 2.11.0+rocm10.0.0
#
# Verify with: bash ~/qwen38/assert_rocm10.sh "$VLLM_IMAGE"
VLLM_IMAGE="vllm/vllm-openai-rocm@sha256:b1374c3814b6e7706c49968ba17ca3b35484382f7b9fc7115dd3e66068d53f2f"
SGLANG_IMAGE="lmsysorg/sglang-rocm@sha256:6aeadaeeb357dd0d36730f3200784c4aece97dd744e99b49d40571d4c796c9dd"
